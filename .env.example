# Единый файл настроек приложения. Все остальные параметры (порт, координаты,
# тема, TLE, SatNOGS, схема станции, исключения) хранятся внутри этого файла.
# При его отсутствии конфиг автогенерируется при первом запуске и записывается
# по этому пути.
SS_CONFIG=data/config.json

# Режим запуска. Влияет на источник шаблонов и статики:
#   true  — чтение с диска (горячая перезагрузка во время разработки),
#   false — встроенный embed.FS (production / Docker).
DEV_MODE=true
